EXPO_PUBLIC_APP_ENV=preview
EXPO_PUBLIC_API_URL=https://api-preview.glipra.com
EXPO_PUBLIC_VAR_NUMBER=2
EXPO_PUBLIC_VAR_BOOL=true

# === Glipra additions ===
# Supabase — to be provisioned
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI mock gate — set to false to test real AI in preview
EXPO_PUBLIC_USE_MOCK_AI=true

# RevenueCat — subscription gating
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog — analytics
EXPO_PUBLIC_POSTHOG_API_KEY=

# Sentry — error tracking
EXPO_PUBLIC_SENTRY_DSN=
