# pnpm config — see ARCHITECTURE.md → "Bundler playbook"
#
# node-linker=hoisted prevents multiple hermes-parser versions from racing
# during transform. Combined with pnpm.overrides in package.json this gives
# a single source-of-truth for the parser version Metro sees.
#
# strict-peer-dependencies=false matches Expo's recommended setting; with
# the Expo SDK 54 + RN 0.81 + Reanimated v4 stack there are several
# documented peer-dep mismatches that are safe to ignore.
node-linker=hoisted
strict-peer-dependencies=false
