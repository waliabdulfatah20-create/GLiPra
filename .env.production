EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_API_URL=https://api.glipra.com
EXPO_PUBLIC_VAR_NUMBER=3
EXPO_PUBLIC_VAR_BOOL=true

# === Glipra additions ===
# Supabase — to be provisioned
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI mock gate — set to false for real AI in production
EXPO_PUBLIC_USE_MOCK_AI=false

# RevenueCat — subscription gating
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog — analytics (1M events/month free)
EXPO_PUBLIC_POSTHOG_API_KEY=

# Sentry — error tracking (5,000 errors/month free)
EXPO_PUBLIC_SENTRY_DSN=
